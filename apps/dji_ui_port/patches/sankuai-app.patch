+
+/* full screen async preview state */
+static lv_obj_t *g_full_img = NULL;
+static lv_obj_t *g_album_toolbar = NULL;
+static lv_timer_t *g_fs_poll = NULL;
+static int g_fs_gen = 0;
+static unsigned char *g_fs_buf = NULL;
+static lv_image_dsc_t g_fs_dsc;
+
+/* ---- fullscreen zoom / pan ------------------------------------------- */
+static uint16_t *g_fs_src = NULL;   /* 原图 RGB565（最多 2560x1440） */
+static int g_fs_sw = 0, g_fs_sh = 0;
+static uint16_t *g_fs_view = NULL;  /* 屏幕尺寸的合成结果 640x480 */
+static float g_fs_fit = 1.0f;       /* 1x 时铺满屏幕的缩放比 */
+static float g_fs_zoom = 1.0f;      /* 用户缩放倍率 */
+static float g_fs_cx = 0, g_fs_cy = 0;
+static uint32_t g_fs_last_tap = 0;
+static int g_fs_last_x = 0, g_fs_last_y = 0;
+
+static void fs_render(void)
+{
+    if (!g_fs_view) return;
+    int sw = ui_get_screen_width(), sh = ui_get_screen_height();
+    int vw = sw, vh = sh;
+    const float cur = g_fs_fit * g_fs_zoom;
+
+    for (int y = 0; y < vh; y++) {
+        uint16_t *drow = g_fs_view + (size_t)y * vw;
+        for (int x = 0; x < vw; x++) {
+            float ix = g_fs_cx + ((float)x - vw * 0.5f) / cur;
+            float iy = g_fs_cy + ((float)y - vh * 0.5f) / cur;
+            if (!g_fs_src || ix < 0 || iy < 0 || ix >= g_fs_sw || iy >= g_fs_sh) {
+                drow[x] = 0x0000;
+            } else {
+                drow[x] = g_fs_src[(size_t)(int)iy * g_fs_sw + (int)ix];
+            }
+        }
+    }
+}
+
+static void fs_apply(void)
+{
+    if (!g_fs_view) return;
+    int sw = ui_get_screen_width(), sh = ui_get_screen_height();
+    memset(&g_fs_dsc, 0, sizeof(g_fs_dsc));
+    g_fs_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
+    g_fs_dsc.header.cf = LV_COLOR_FORMAT_RGB565;
+    g_fs_dsc.header.w = sw;
+    g_fs_dsc.header.h = sh;
+    g_fs_dsc.header.stride = (uint32_t)sw * 2;
+    g_fs_dsc.data_size = (uint32_t)sw * sh * 2;
+    g_fs_dsc.data = (const uint8_t *)g_fs_view;
+    if (g_full_img) {
+        lv_image_set_src(g_full_img, &g_fs_dsc);
+        lv_image_set_scale(g_full_img, 256);
+    }
+    lv_obj_invalidate(g_full_img);
+}
+
+/* 双击：1x <-> 2.5x；放大时按住拖动平移 */
+static void fs_click_cb(lv_event_t *e)
+{
+    lv_indev_t *indev = lv_indev_active();
+    if (!indev) return;
+    lv_point_t p;
+    lv_indev_get_point(indev, &p);
+    uint32_t now = lv_tick_get();
+    if (now - g_fs_last_tap < 350 &&
+        abs(p.x - g_fs_last_x) < 40 && abs(p.y - g_fs_last_y) < 40) {
+        if (g_fs_zoom > 1.01f) {
+            g_fs_zoom = 1.0f;
+            g_fs_cx = g_fs_sw * 0.5f;
+            g_fs_cy = g_fs_sh * 0.5f;
+        } else {
+            float cur = g_fs_fit * 2.5f;
+            g_fs_zoom = 2.5f;
+            g_fs_cx = g_fs_sw * 0.5f + ((float)p.x - ui_get_screen_width() * 0.5f) / cur;
+            g_fs_cy = g_fs_sh * 0.5f + ((float)p.y - ui_get_screen_height() * 0.5f) / cur;
+        }
+        fs_render();
+        fs_apply();
+        LV_LOG_USER("Album: zoom=%.1f center=(%.0f,%.0f)", g_fs_zoom, g_fs_cx, g_fs_cy);
+        g_fs_last_tap = 0;
+        return;
+    }
+    g_fs_last_tap = now;
+    g_fs_last_x = p.x;
+    g_fs_last_y = p.y;
+}
+
+static void fs_pressing_cb(lv_event_t *e)
+{
+    (void)e;
+    if (g_fs_zoom <= 1.01f || !g_fs_src) return;
+    lv_indev_t *indev = lv_indev_active();
+    if (!indev) return;
+    lv_point_t p;
+    lv_indev_get_point(indev, &p);
+    static lv_point_t last = {0, 0};
+    static bool init = false;
+    if (!init) { last = p; init = true; return; }
+    float cur = g_fs_fit * g_fs_zoom;
+    g_fs_cx -= (p.x - last.x) / cur;
+    g_fs_cy -= (p.y - last.y) / cur;
+    if (g_fs_cx < 0) g_fs_cx = 0;
+    if (g_fs_cy < 0) g_fs_cy = 0;
+    if (g_fs_cx > g_fs_sw) g_fs_cx = g_fs_sw;
+    if (g_fs_cy > g_fs_sh) g_fs_cy = g_fs_sh;
+    last = p;
+    fs_render();
+    fs_apply();
+}
+
+static void fs_poll_cb(lv_timer_t *t)
+{
+    (void)t;
+    char *buf = NULL; int w = 0, h = 0, gen = 0;
+    while (thumb_preview_poll(&buf, &w, &h, &gen)) {
+        if (gen != g_fs_gen) { free(buf); buf = NULL; continue; }
+        free(g_fs_src);
+        g_fs_src = (uint16_t *)buf;
+        g_fs_sw = w;
+        g_fs_sh = h;
+
+        int sw = ui_get_screen_width(), sh = ui_get_screen_height();
+        if (!g_fs_view) {
+            g_fs_view = (uint16_t *)malloc((size_t)sw * sh * 2);
+            if (!g_fs_view) { LV_LOG_ERROR("fullscreen: out of memory"); return; }
+        }
+        float fx = (float)sw / (float)(w > 0 ? w : 1);
+        float fy = (float)sh / (float)(h > 0 ? h : 1);
+        g_fs_fit = (fx < fy) ? fx : fy;
+        g_fs_zoom = 1.0f;
+        g_fs_cx = w * 0.5f;
+        g_fs_cy = h * 0.5f;
+        g_fs_last_tap = 0;
+        fs_render();
+        fs_apply();
+        LV_LOG_USER("Album: fullscreen %dx%d fit=%.3f obj=%dx%d", w, h, g_fs_fit,
+                    (int)lv_obj_get_width(g_full_img), (int)lv_obj_get_height(g_full_img));
+        break;
+    }
+}
+
+static void ensure_fs_poll_timer(void)
+{
+    if (!g_fs_poll) g_fs_poll = lv_timer_create(fs_poll_cb, 30, NULL);
+}
