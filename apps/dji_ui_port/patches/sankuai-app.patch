+
+static void home_battery_update(void)
+{
+    if (!g_bat_label) return;
+    int pct = -1, charging = 0;
+    if (board_battery_read(&pct, &charging) != 0 || pct < 0) {
+        lv_label_set_text(g_bat_label, LV_SYMBOL_BATTERY_EMPTY " --");
+        lv_obj_set_style_text_color(g_bat_label, lv_color_hex(0x888888), 0);
+        return;
+    }
+
+    const char *icon = LV_SYMBOL_BATTERY_EMPTY;
+    if (pct >= 90) icon = LV_SYMBOL_BATTERY_FULL;
+    else if (pct >= 60) icon = LV_SYMBOL_BATTERY_3;
+    else if (pct >= 35) icon = LV_SYMBOL_BATTERY_2;
+    else if (pct >= 15) icon = LV_SYMBOL_BATTERY_1;
+
+    char buf[32];
+    snprintf(buf, sizeof(buf), "%s%s %d%%", icon, charging ? LV_SYMBOL_CHARGE : "", pct);
+    lv_label_set_text(g_bat_label, buf);
+
+    /* 低电提醒：<=15% 且未充电，只在跨过阈值时弹一次 */
+    if (pct <= 15 && !charging) {
+        lv_obj_set_style_text_color(g_bat_label, lv_color_hex(0xFF3B30), 0);
+        if (!g_bat_low_warned) {
+            g_bat_low_warned = 1;
+            home_show_toast(tr("电量低，请及时充电", "Low battery, please charge"));
+        }
+    } else {
+        lv_obj_set_style_text_color(g_bat_label, charging ? lv_color_hex(0x34C759) : lv_color_white(), 0);
+        if (pct > 20) g_bat_low_warned = 0;
+    }
+}
+
+static void home_battery_timer_cb(lv_timer_t *t)
+{
+    (void)t;
+    home_battery_update();
+}
