 /* 对外接口：从根目录开始扫描（depth=0） */
+/* mtime lookup, path may be "A:/path" */
+static time_t photo_mtime(const char *p)
+{
+    if (!p) return 0;
+    if (p[0] == 'A' && p[1] == ':') p += 2;
+    struct stat st;
+    return (stat(p, &st) == 0) ? st.st_mtime : 0;
+}
+
+static int photo_cmp_newest_first(const void *a, const void *b)
+{
+    time_t ta = photo_mtime((const char *)a);
+    time_t tb = photo_mtime((const char *)b);
+    if (ta == tb) return strcmp((const char *)a, (const char *)b) * -1;
+    return (ta < tb) ? 1 : -1;   /* newest first */
+}
+
+/* 按修改时间倒序排列（最新的在最前） */
+static void sort_photos_newest_first(int count)
+{
+    if (count <= 1) return;
+    /* g_photos 是二维数组，元素宽度 ALBUM_PATH_LEN，可直接 qsort */
+    qsort(g_photos, (size_t)count, ALBUM_PATH_LEN, photo_cmp_newest_first);
