+/* full screen async preview state */
+static lv_obj_t *g_full_img = NULL;
+static lv_timer_t *g_fs_poll = NULL;
+static int g_fs_gen = 0;
+static unsigned char *g_fs_buf = NULL;
+static lv_image_dsc_t g_fs_dsc;
+
+static void fs_poll_cb(lv_timer_t *t)
+{
+    (void)t;
+    char *buf = NULL; int w = 0, h = 0, gen = 0;
+    while (thumb_preview_poll(&buf, &w, &h, &gen)) {
+        if (gen != g_fs_gen) { free(buf); buf = NULL; continue; }
+        free(g_fs_buf);
+        g_fs_buf = (unsigned char *)buf;
+        memset(&g_fs_dsc, 0, sizeof(g_fs_dsc));
+        g_fs_dsc.header.magic = LV_IMAGE_HEADER_MAGIC;
+        g_fs_dsc.header.cf = LV_COLOR_FORMAT_RGB565;
+        g_fs_dsc.header.w = w;
+        g_fs_dsc.header.h = h;
+        g_fs_dsc.data_size = (uint32_t)w * h * 2;
+        g_fs_dsc.data = g_fs_buf;
+        if (g_full_img) lv_image_set_src(g_full_img, &g_fs_dsc);
+        LV_LOG_USER("Album: fullscreen ready %dx%d gen=%d", w, h, gen);
+        break;
+    }
+}
+
+static void ensure_fs_poll_timer(void)
+{
+    if (!g_fs_poll) g_fs_poll = lv_timer_create(fs_poll_cb, 30, NULL);
+}
