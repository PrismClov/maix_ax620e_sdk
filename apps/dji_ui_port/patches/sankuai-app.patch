+/* Signature of the current photo list: skip the expensive grid rebuild when
+ * nothing changed (re-entering the album is then ~instant). */
+static int s_grid_built = 0;
+static uint32_t s_list_sig = 0;
+
+static uint32_t album_list_signature(void)
+{
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < g_photo_count; i++) {
+        for (const char *p = g_photos[i]; *p; p++) { h ^= (uint8_t)*p; h *= 16777619u; }
+    }
+    h ^= (uint32_t)g_photo_count;
+    return h;
+}
